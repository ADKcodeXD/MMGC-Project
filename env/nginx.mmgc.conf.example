# MMGC project-level Nginx example.
# Copy to /etc/nginx/conf.d/mmgc.conf and replace domains, certificate paths, and upstreams.
# Asset domains such as assets.mirai-mad.com should normally CNAME to CDN, not to this Nginx.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Optional country switch. This only works when your CDN/proxy passes CF-IPCountry.
# Keep the redirect disabled until you confirm the header exists in access logs.
map $http_cf_ipcountry $mmgc_is_oversea {
    default 1;
    CN 0;
    "" 0;
}

upstream mmgc_frontend {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream mmgc_backend {
    server 127.0.0.1:8055;
    keepalive 32;
}

upstream mmgc_admin {
    server 127.0.0.1:8080;
    keepalive 16;
}

upstream mmgc_admin_next {
    server 127.0.0.1:8081;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name mirai-mad.com www.mirai-mad.com global.mirai-mad.com;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mirai-mad.com www.mirai-mad.com;

    ssl_certificate /etc/nginx/ssl/mirai-mad.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/mirai-mad.com/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:MMGCSSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 1024m;

    # Optional overseas redirect. Enable only after confirming a trusted proxy sets CF-IPCountry.
    # if ($mmgc_is_oversea) {
    #     return 302 https://global.mirai-mad.com$request_uri;
    # }

    location ^~ /mmgcApi/ {
        proxy_pass http://mmgc_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Current old Admin build uses VITE_PUBLIC_PATH=/admin.
    # The trailing slash in proxy_pass strips /admin/ before forwarding to the admin container.
    location ^~ /admin/ {
        proxy_pass http://mmgc_admin/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location = /admin {
        return 301 /admin/;
    }

    # Optional React admin-next preview.
    location ^~ /admin-next/ {
        proxy_pass http://mmgc_admin_next/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location = /admin-next {
        return 301 /admin-next/;
    }

    location / {
        proxy_pass http://mmgc_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# Optional overseas frontend. If you do not deploy a separate overseas source,
# keep this block pointing to the same frontend or remove global.mirai-mad.com DNS.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name global.mirai-mad.com;

    ssl_certificate /etc/nginx/ssl/global.mirai-mad.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/global.mirai-mad.com/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:MMGCGLOBALSSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 1024m;

    location ^~ /mmgcApi/ {
        proxy_pass http://mmgc_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://mmgc_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
