## MMGC Backend Production Environment
## Copy to: env/backend.env.production
## Never commit the copied production file or any real secret.

# -----------------------------------------------------------------------------
# 1. Backend service (required)
# -----------------------------------------------------------------------------
APP_PORT=8055
HOST_NAME=0.0.0.0
MMGC_PREFIX=/mmgcApi
SYS_CONFIG=1

# -----------------------------------------------------------------------------
# 2. MongoDB (required)
# Docker Compose uses the service name "mongodb".
# MONGO_USERNAME and MONGO_PASSWORD must match the MongoDB account used by Compose.
# -----------------------------------------------------------------------------
MONGO_PATH=mongodb://mongodb:27017
MONGO_COLLECTION=mmgc
MONGO_USERNAME=<mongo-username>
MONGO_PASSWORD=<mongo-strong-password>

# -----------------------------------------------------------------------------
# 3. Authentication and encryption (required)
# Generate independent, high-entropy random values. Do not reuse the R2 secret.
# -----------------------------------------------------------------------------
JWT_SECRET=<long-random-jwt-secret>
AES_PASSWORD=<long-random-aes-password>
AES_SALT=<random-aes-salt>
AES_IV=<random-aes-iv>

# -----------------------------------------------------------------------------
# 4. Cloudflare R2 upload (required)
# R2_ENDPOINT must be the account-level S3 endpoint, without the bucket suffix.
# R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY come from an R2 S3 API token.
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://ad0fbae96e038dfc400cb5ef8f6cab42.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=miraimad

# Public asset domains. Do not add a trailing slash.
R2_PUBLIC_URL=https://assets.mirai-mad.com
R2_CN_PUBLIC_URL=https://assets-cn.mirai-mad.com

# Leave R2_IMAGE_PATH empty to upload images at the bucket root.
R2_IMAGE_PATH=
R2_VIDEO_PATH=mmgc/video

# -----------------------------------------------------------------------------
# 5. Cloudflare R2 Analytics and fee dashboard (required for statistics)
# Create a separate Cloudflare API Token with:
# Account -> Account Analytics -> Read
# The R2 S3 Access Key above cannot be used as this API Token.
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=ad0fbae96e038dfc400cb5ef8f6cab42
CLOUDFLARE_API_TOKEN=<cloudflare-account-analytics-read-token>

# -----------------------------------------------------------------------------
# 6. Redis (required)
# Docker Compose uses the service name "redis". Leave username empty for the
# default Redis user. REDIS_PASSWORD must match the Compose Redis password.
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=<redis-strong-password>

# -----------------------------------------------------------------------------
# 7. Email verification (optional; required only when email sending is enabled)
# -----------------------------------------------------------------------------
EMAIL_SMTP_HOST=smtp.exmail.qq.com
EMAIL_SMTP_PORT=465
EMAIL_USER=
EMAIL_PASS=

# -----------------------------------------------------------------------------
# 8. AI translation (optional)
# Any OpenAI-compatible provider can be used.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=google/gemini-2.5-flash
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# 9. Legacy Qiniu site-traffic widget (optional)
# Leave empty if the old SiteTrafficStat widget is no longer needed.
# These values are never used for upload or the Cloudflare R2 fee dashboard.
# -----------------------------------------------------------------------------
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_CDN_LINK=
QINIU_FRONTEND_DOMAIN=

# CN acceleration switch:
# This is not an environment variable. Enable "enableCnAssetAcceleration" in
# the Admin global configuration. CN clients will then receive
# https://assets-cn.mirai-mad.com; all other clients use the primary domain.
