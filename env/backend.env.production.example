## Backend Production Environment
## Copy this file to backend.env.production and fill in actual values

# Server
APP_PORT=8055
HOST_NAME=0.0.0.0
MMGC_PREFIX=/mmgcApi

# MongoDB（Docker Compose 内使用服务名 mongodb；宿主机直接跑则 127.0.0.1）
MONGO_PATH=mongodb://mongodb:27017
MONGO_COLLECTION=mmgc
MONGO_USERNAME=
MONGO_PASSWORD=

# Tencent COS
SECRET_ID=
SECRET_KEY=
BUCKET_NAME=
REGION=
COS_BASE_PATH=
COS_VIDEO_PATH=
COS_SERVER_PATH=

# Email
EMAIL_SMTP_HOST=smtp.exmail.qq.com
EMAIL_SMTP_PORT=465
EMAIL_USER=
EMAIL_PASS=

# AES & JWT
AES_PASSWORD=
AES_SALT=
AES_IV=
JWT_SECRET=

# Default config
SYS_CONFIG=1

# CDN / Object Storage
# 当前后端已实现 qiniu 兼容链路；CDN_* 是面向后续 adapter 的统一命名。
# 如果同时填写 CDN_* 和 QINIU_*，当前代码优先使用 QINIU_*。
CDN_ADAPTER=qiniu
CDN_ACCESS_KEY=
CDN_SECRET_KEY=
CDN_BUCKET=
CDN_LINK=https://assets.example.com
CDN_GLOBAL_LINK=https://assets-global.example.com
CDN_FRONTEND_DOMAIN=https://example.com

# Qiniu CDN（兼容旧配置；已有环境可以继续使用这一组）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_CDN_LINK=
QINIU_GLOBAL_CDN_LINK=
QINIU_FRONTEND_DOMAIN=

# Redis（Docker Compose 内使用服务名 redis；宿主机直接跑则 127.0.0.1）
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

# AI Translation (OpenAI-compatible APIs like OpenAI, Apifast, OpenRouter, etc.)
OPENAI_API_KEY=sk-
OPENAI_MODEL=gemini-3-flash-preview-maxthinking
OPENAI_BASE_URL=https://api.apifast.tech/v1
