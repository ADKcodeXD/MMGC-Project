## Local/non-Docker production example
## Copy to: apps/backend/.env.production
## For Docker deployment, use ../../env/backend.env.production.example instead.

APP_PORT=8055
HOST_NAME=127.0.0.1
MMGC_PREFIX=/mmgcApi
SYS_CONFIG=1

# MongoDB
MONGO_PATH=mongodb://127.0.0.1:27017
MONGO_COLLECTION=mmgc
MONGO_USERNAME=<mongo-username>
MONGO_PASSWORD=<mongo-strong-password>

# Authentication and encryption
JWT_SECRET=<long-random-jwt-secret>
AES_PASSWORD=<long-random-aes-password>
AES_SALT=<random-aes-salt>
AES_IV=<random-aes-iv>

# Cloudflare R2 upload
R2_ENDPOINT=https://ad0fbae96e038dfc400cb5ef8f6cab42.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=miraimad
R2_PUBLIC_URL=https://assets.mirai-mad.com
R2_CN_PUBLIC_URL=https://assets-cn.mirai-mad.com
R2_IMAGE_PATH=
R2_VIDEO_PATH=mmgc/video

# Cloudflare R2 Analytics and fee dashboard
# Token permission: Account -> Account Analytics -> Read
CLOUDFLARE_ACCOUNT_ID=ad0fbae96e038dfc400cb5ef8f6cab42
CLOUDFLARE_API_TOKEN=<cloudflare-account-analytics-read-token>

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=<redis-strong-password>

# Email verification (optional)
EMAIL_SMTP_HOST=smtp.exmail.qq.com
EMAIL_SMTP_PORT=465
EMAIL_USER=
EMAIL_PASS=

# AI translation (optional)
OPENAI_API_KEY=
OPENAI_MODEL=google/gemini-2.5-flash
OPENAI_BASE_URL=https://api.openai.com/v1

# Legacy Qiniu site-traffic widget only (optional)
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_CDN_LINK=
QINIU_FRONTEND_DOMAIN=
