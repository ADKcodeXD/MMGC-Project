# public path
VITE_PUBLIC_PATH = /

# Cross-domain proxy for local admin debugging against online API
VITE_PROXY = [["/api","https://mirai-mad.com/mmgcApi"]]

# Delete console
VITE_DROP_CONSOLE = false

# Basic interface address SPA
VITE_GLOB_API_URL=/api

# File upload address, optional
VITE_GLOB_UPLOAD_URL=https://localhost:1234

# Interface prefix
VITE_GLOB_API_URL_PREFIX=

VITE_GLOB_UPLOAD_PATH=mmgc/video

VITE_GLOB_UPLOAD_CDNLINK=https://assets.mirai-mad.com

VITE_GLOB_UPLOAD_LINK=https://up-z2.qiniup.com
